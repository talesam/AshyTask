# Telegram Bot Token
# Obtenha o token com @BotFather no Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# IDs de administradores separados por vírgula.
# Quando vazio, o gerenciamento de categorias fica aberto para manter compatibilidade.
ADMIN_IDS=

# Bot API 9.4+: estilos de botões inline (primary/success/danger).
TELEGRAM_BUTTON_STYLES=1

# Bot API 9.4+: IDs de emojis customizados/animados para ícones de botão.
# Formato: success=ID,danger=ID,primary=ID,delete=ID
TELEGRAM_BUTTON_CUSTOM_EMOJI_IDS=

# Exemplo:
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
